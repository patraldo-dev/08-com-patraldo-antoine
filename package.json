{
	"name": "08-com-patraldo-antoine",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/generate-routes.js && vite build",
		"generate:routes": "node scripts/generate-routes.js",
		"preview": "pnpm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"deploy": "pnpm run build && wrangler deploy",
		"locales:init": "bash scripts/generate-locales.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.160.1"
	},
	"dependencies": {
		"@iwsdk/core": "^0.5.3",
		"colorthief": "^3.5.0",
		"elics": "^3.4.1",
		"jspdf": "^4.2.1",
		"matter-js": "^0.20.0",
		"three": "^0.187.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
